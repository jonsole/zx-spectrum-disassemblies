; Ref file for the Cyberun HTML disassembly, used by
; scripts/build_cyberun.py --html. Like scripts/cyberun_annotations.ctl this
; is source rather than output: prose and addresses only, no game bytes, so
; it is committed. Pages that quote the game -- its landscape, its sprites,
; its sounds -- are generated by the page modules the build names in
; PAGE_MODULES (scripts/cyberun_*.py, each with build(snapshot, html_dir,
; log) returning its ref sections) into
; game_disassembly/cyberun/cyberun-pages.ref. Add a module's pages to
; the index below in the same change that adds the module: a page here that
; includes a section no module wrote stops the build.
;
; Careful with semicolons: one is a comment only at the start of a line.
; Careful with macro names too -- a skool macro's name written in prose is
; expanded rather than printed, and the build fails.

[Game]
Game=Cyberun
Copyright=&copy; 1986 Ultimate Play the Game
Release=Disassembled from the original tape image
Created=Disassembled from the tape by <a href="https://skoolkit.ca">SkoolKit</a> #VERSION, driven by <code>scripts/build_cyberun.py</code>.
LinkOperands=CALL,DEFW,DJNZ,JP,JR,LD
; The title from the tape's loading screen (write_logo in the build).
LogoImage=images/logo.png
; Ultimate's family look: Atic Atac's colours and Knight Lore's pages, with
; what these pages add on top in cyberun.css.
StyleSheet=skoolkit.css;aticatac.css;knightlore.css;cyberun.css;site.css

[ImageWriter]
PNGAlpha=0

