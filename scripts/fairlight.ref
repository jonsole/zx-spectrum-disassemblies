; Ref file for the Fairlight HTML disassembly, used by
; scripts/build_fairlight.py --html. Like scripts/fairlight_annotations.ctl
; this is source rather than output: prose and addresses only, no game bytes,
; so it is committed. Pages that quote the game -- its rooms, its sprites, its
; sounds -- are generated by the page modules the build names in
; PAGE_MODULES (scripts/fairlight_*.py, each with build(snapshot, html_dir,
; log) returning its ref sections) into
; game_disassembly/fairlight/fairlight-pages.ref. Add a module's pages to
; [Index] below in the same change that adds the module: a page here that
; #INCLUDEs a section no module wrote stops the build.
;
; The prose pages are "box pages": [Page:X] names a SectionPrefix, and each
; [X:anchor:Title] section below becomes one titled block on that page.
;
; Careful with semicolons: one is a comment only at the start of a line.
; Careful with macro names too -- #UDGARRAY or #FONT written in prose is
; expanded rather than printed, and the build fails.

[Game]
Game=Fairlight
Copyright=&copy; 1985 The Edge / Bo Jangeborg
Release=Disassembled from the original tape image (Release 2)
Created=Disassembled from the tape by <a href="https://skoolkit.ca">SkoolKit</a> #VERSION, driven by <code>scripts/build_fairlight.py</code>.
LinkOperands=CALL,DEFW,DJNZ,JP,JR,LD
; The title from the tape's loading screen (fairlight_data.write_logo).
LogoImage=images/logo.png
; The family look the other games' pages share (Atic Atac's colours and
; Knight Lore's pages), with what these pages add on top in fairlight.css.
StyleSheet=skoolkit.css;aticatac.css;knightlore.css;fairlight.css;site.css

[ImageWriter]
; The sprites are drawn with the game's own mask, and what the mask leaves
; clear should be clear on the page too, not SkoolKit's opaque green.
PNGAlpha=0

[Index]
MemoryMaps
