; Ref file for The Hobbit's HTML disassembly, used by scripts/build_hobbit.py
; --html. Like scripts/hobbit_annotations.ctl this is source rather than
; output: prose and addresses only, no game bytes, so it is committed.
;
; The "The game" pages -- the map, locations, objects, characters, actions -- are
; laid out here, but their content is the game's own (room descriptions,
; names, pictures), so scripts/hobbit_pages.py generates it on every build into
; game_disassembly/hobbit/hobbit-pages.ref, which is not committed. Each page
; here only #INCLUDEs its section from that file.
;
; A ref file has no multi-line values, so the prose pages are "box pages":
; [Page:X] names a SectionPrefix, and each [X:anchor:Title] section becomes one
; titled block on that page.

[Game]
Game=The Hobbit
LogoImage=images/logo.png
Copyright=&copy; 1982 Beam Software / Melbourne House
Release=Disassembled from the v1.2 tape
Created=Disassembled from the tape by <a href="https://skoolkit.ca">SkoolKit</a> #VERSION, driven by <code>scripts/build_hobbit.py</code>.
LinkOperands=CALL,DEFW,DJNZ,JP,JR

