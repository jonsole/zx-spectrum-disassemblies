; Ref file for the Pentagram HTML disassembly, used by
; scripts/build_pentagram.py --html. Like scripts/pentagram_annotations.ctl
; this is source rather than output: prose and addresses only, no game bytes,
; so it is committed. Pages that quote the game -- its rooms, its sprites, its
; sounds -- are generated by the page modules the build names in PAGE_MODULES
; (scripts/pentagram_*.py, each with build(snapshot, html_dir, log) returning
; its ref sections) into game_disassembly/pentagram/pentagram-pages.ref. Add a
; module's pages to [Index] below in the same change that adds the module:
; a page here that #INCLUDEs a section no module wrote stops the build.
;
; The prose pages are "box pages": [Page:X] names a SectionPrefix, and each
; [X:anchor:Title] section below becomes one titled block on that page. A ref
; file has no multi-line values, so this is the only way to write a page of
; prose -- PageContent= would have to be a single very long line.
;
; Careful with semicolons: one is a comment only at the start of a line.
; Careful with macro names too -- #UDGARRAY or #FONT written in prose is
; expanded rather than printed, and the build fails.

[Game]
Game=Pentagram
Copyright=&copy; 1986 Ultimate Play the Game
Release=Disassembled from the original tape image
Created=Disassembled from the tape by <a href="https://skoolkit.ca">SkoolKit</a> #VERSION, driven by <code>scripts/build_pentagram.py</code>.
LinkOperands=CALL,DEFW,DJNZ,JP,JR,LD
; Ultimate's family look: Atic Atac's colours and Knight Lore's pages, with
; what these pages add on top in pentagram.css.
StyleSheet=skoolkit.css;aticatac.css;knightlore.css;pentagram.css;site.css

[ImageWriter]
; The sprites are drawn with the game's own mask, and what the mask leaves
; clear should be clear on the page too, not SkoolKit's opaque green.
PNGAlpha=0

